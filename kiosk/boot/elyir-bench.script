# The Elyir Bench eye, drawn while the Pi boots, reboots or shuts down (design/boot/, E: the Elyir signature).
# Template: make-plymouth.py fills in the placeholders from app/src/boot/mark.json and draws the images.
#
# Booting: elyir is written by hand, as Home Hub starts; the dot of the i lights in the accent, the name
# fades, and the dot glides down and grows into the eye's pupil while a thin track draws itself round
# from twelve o'clock. Then the ring fills with Plymouth's own boot progress (timed against the previous
# boot) up to @HANDOFF@ of a turn. The kiosk quits Plymouth keeping this last frame on screen
# (plymouth quit --retain-splash), and the app's boot screen, drawn from the same geometry, carries the
# ring the rest of the way.
# Shutting down or rebooting, the ring empties and the pupil dims. The panel goes dark when the Pi halts, and that is
# the sign it's safe to switch off (design/power/: the app says so; a sentence here showed before the halt, too early).

Window.SetBackgroundTopColor(@BG_R@, @BG_G@, @BG_B@);
Window.SetBackgroundBottomColor(@BG_R@, @BG_G@, @BG_B@);

# The same fit as the app's 800x480 viewBox: scale to the smaller side, centered.
W = Window.GetWidth();
H = Window.GetHeight();
s = Math.Min(W / @DW@, H / @DH@);
k = s / @IMG_SCALE@;
cx = Window.GetX() + W / 2 + (@CX@ - @DW@ / 2) * s;
cy = Window.GetY() + H / 2 + (@CY@ - @DH@ / 2) * s;
fun at_x(x) { return Window.GetX() + global.W / 2 + (x - @DW@ / 2) * global.s; }
fun at_y(y) { return Window.GetY() + global.H / 2 + (y - @DH@ / 2) * global.s; }

fun scaled(name) {
  img = Image(name);
  return img.Scale(Math.Int(img.GetWidth() * global.k + 0.5), Math.Int(img.GetHeight() * global.k + 0.5));
}
fun center_on(sprite, img, z) {
  sprite.SetPosition(global.cx - img.GetWidth() / 2, global.cy - img.GetHeight() / 2, z);
}
fun ease(x) {
  if (x < 0.5) return 4 * x * x * x;
  y = 2 - 2 * x;
  return 1 - y * y * y / 2;
}
fun ease_out(x) {
  y = 1 - x;
  return 1 - y * y * y;
}

pupil_image = scaled("pupil.png");
pupil = Sprite(pupil_image);
center_on(pupil, pupil_image, 3);
pupil.SetOpacity(0);

# Ring frames are loaded the first time they are needed: a boot only ever shows a few dozen.
frames[0] = scaled("ring-0.png");
ring = Sprite(frames[0]);
center_on(ring, frames[0], 1);
ring.SetOpacity(0);
shown = -1;

fun show(f) {
  f = Math.Clamp(Math.Int(f + 0.5), 0, @FRAMES@);
  if (f != global.shown) {
    if (!global.frames[f]) global.frames[f] = scaled("ring-" + f + ".png");
    global.ring.SetImage(global.frames[f]);
    center_on(global.ring, global.frames[f], 1);
    global.shown = f;
  }
}

outlined = -1;
fun outline(f) {
  f = Math.Clamp(Math.Int(f + 0.5), 0, @OUTLINE@);
  if (f != global.outlined) {
    img = scaled("outline-" + f + ".png");
    global.ring.SetImage(img);
    center_on(global.ring, img, 1);
    global.outlined = f;
  }
}

mode = Plymouth.GetMode();
ticks = 0;
target = 0;     # boot progress, in ring frames
arc = 0;        # what the ring shows, easing toward it

if (mode == "boot") {
  name = Sprite();
  name.SetPosition(at_x(@NAME_X@), at_y(@NAME_Y@), 1);
  named = -1;
  dot_image = scaled("dot.png");
  dot = Sprite(dot_image);
  dot.SetOpacity(0);
  glow_image = scaled("glow.png");
  glow = Sprite(glow_image);
  glow.SetOpacity(0);
  tx = at_x(@TX@);
  ty = at_y(@TY@);
  dot_size = -1;
}

fun write(f) {
  f = Math.Clamp(Math.Int(f + 0.5), 0, @NAME@);
  if (f != global.named) {
    global.name.SetImage(scaled("name-" + f + ".png"));
    global.named = f;
  }
}

# The i's dot at a fraction g of the pupil's size, centered on x, y: the unlit dot, the lit one (the pupil
# itself) over it, and the glow under both.
fun place_dot(g, x, y) {
  size = Math.Max(1, Math.Int(global.pupil_image.GetWidth() * g + 0.5));
  if (size != global.dot_size) {
    global.lit_image = global.pupil_image.Scale(size, size);
    global.pupil.SetImage(global.lit_image);
    global.unlit_image = global.dot_image.Scale(size, size);
    global.dot.SetImage(global.unlit_image);
    gs = Math.Max(1, Math.Int(global.glow_image.GetWidth() * g + 0.5));
    global.glowing = global.glow_image.Scale(gs, gs);
    global.glow.SetImage(global.glowing);
    global.dot_size = size;
  }
  global.pupil.SetPosition(x - size / 2, y - size / 2, 3);
  global.dot.SetPosition(x - size / 2, y - size / 2, 2);
  gw = global.glowing.GetWidth();
  global.glow.SetPosition(x - gw / 2, y - gw / 2, 1);
}

# Called about 50 times a second: these times are in ticks of 20 ms.
fun refresh() {
  t = global.ticks;
  global.ticks = t + 1;
  if (global.mode == "boot") {
    # elyir, written over 2.6 s, held, and gone by 5.7 s
    if (t >= 10 && t <= 290) {
      write(ease(Math.Clamp((t - 10) / 130, 0, 1)) * @NAME@);
      global.name.SetOpacity(1 - ease(Math.Clamp((t - 240) / 45, 0, 1)));
    }
    # the dot of the i: there at 2.9 s, lit by 4.1 s, then it glides into the eye and is its pupil from 6.1 s
    if (t >= 145 && t <= 306) {
      move = ease(Math.Clamp((t - 245) / 60, 0, 1));
      lit = ease(Math.Clamp((t - 165) / 40, 0, 1));
      shown = Math.Clamp((t - 145) / 15, 0, 1);
      place_dot(@DOT0@ + (1 - @DOT0@) * move, global.tx + (global.cx - global.tx) * move, global.ty + (global.cy - global.ty) * move);
      if (t < 305) global.dot.SetOpacity(shown);
      else global.dot.SetOpacity(0);
      global.pupil.SetOpacity(shown * lit);
      global.glow.SetOpacity(lit * (1 - move));
    }
    # the track draws itself round, then the ring fills toward the boot's progress
    if (t >= 290 && t < 345) {
      global.ring.SetOpacity(1);
      outline(ease(Math.Clamp((t - 290) / 55, 0, 1)) * @OUTLINE@);
    } else if (t >= 345) {
      global.arc = global.arc + (global.target - global.arc) * 0.1;
      show(global.arc);
    }
  } else {
    global.pupil.SetOpacity(Math.Max(0.45, 1 - t / 150));
    global.ring.SetOpacity(1);
    show(@FRAMES@ - t * @FRAMES@ / 75);
  }
}

fun progress(duration, p) {
  if (global.mode == "boot") global.target = p * @HANDOFF@ * @FRAMES@;
}

if (mode != "boot") {
  pupil.SetOpacity(1);
  show(@FRAMES@);
}
Plymouth.SetRefreshFunction(refresh);
Plymouth.SetBootProgressFunction(progress);
